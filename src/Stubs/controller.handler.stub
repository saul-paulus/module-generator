<?php

declare(strict_types=1);

namespace App\Http\Controllers\{{namespace}};

use App\Http\Controllers\Controller;
use App\Services\{{namespace}}\{{name}}Service;
use App\Support\ApiResponse;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;

final class {{name}}Controller extends Controller
{
    public function __construct(
        private readonly {{name}}Service ${{nameVariable}}Service
    ) {}

    public function handlerGetAll(): JsonResponse
    {
        $data = $this->{{nameVariable}}Service->getAll();
        $meta = [
            'count' => $data->count(),
        ];
        return ApiResponse::success($data, 'Data retrieved successfully', 200, $meta);
    }

    public function handlerGetById(int $id): JsonResponse
    {
        $data = $this->{{nameVariable}}Service->getById($id);
        return ApiResponse::success($data);
    }

    public function handlerCreate(Request $request): JsonResponse
    {
        $data = $this->{{nameVariable}}Service->create($request->all());
        return ApiResponse::success($data, 'Data created successfully', 201);
    }

    public function handlerUpdate(Request $request, int $id): JsonResponse
    {
        $data = $this->{{nameVariable}}Service->update($id, $request->all());
        return ApiResponse::success($data, 'Data updated successfully');
    }

    public function handlerDelete(int $id): JsonResponse
    {
        $this->{{nameVariable}}Service->delete($id);
        return ApiResponse::success(null, 'Data deleted successfully');
    }
}
