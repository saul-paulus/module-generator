<?php

declare(strict_types=1);

namespace App\Repositories\Repository\{{namespace}};

use App\Models\{{namespace}}\{{name}}Model;
use App\Repositories\Interfaces\{{namespace}}\{{name}}Interface;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\Database\Eloquent\Model;

final class {{name}}Repository implements {{name}}Interface
{
    public function __construct(
        private readonly {{name}}Model $model
    ) {}

    /**
     * Get all data
     */
    public function getAll(): Collection
    {
        return $this->model->all();
    }

    /**
     * Get data by id
     */
    public function findById(int $id): ?Model
    {
        return $this->model->find($id);
    }

    /**
     * Get data by id or throw exception
     */
    public function findOrFail(int $id): Model
    {
        return $this->model->findOrFail($id);
    }

    /**
     * Create new data
     */
    public function create(array $data): Model
    {
        return $this->model->create($data);
    }

    /**
     * Update data by id
     */
    public function update(int $id, array $data): bool
    {
        $model = $this->findById($id);

        if (!$model) {
            return false;
        }

        return $model->update($data);
    }

    /**
     * Delete data by id
     */
    public function delete(int $id): bool
    {
        $model = $this->findById($id);

        if (!$model) {
            return false;
        }

        return (bool) $model->delete();
    }

    /**
     * Get data with conditions
     */
    public function findBy(array $conditions): Collection
    {
        return $this->model
            ->where($conditions)
            ->get();
    }

    /**
     * Paginate data
     */
    public function paginate(int $perPage = 15): LengthAwarePaginator
    {
        return $this->model->paginate($perPage);
    }
}
