    private function validateUpdate(Model $model, array $data): void
    {
        // Example:
        // if ($model->status === 'CLOSED') {
        //     throw new \DomainException('Data has been closed');
        // }
    }

    private function validateDelete(Model $model): void
    {
        // Example:
        // if ($model->status === 'ACTIVE') {
        //     throw new \DomainException('Active records cannot be deleted');
        // }
    }
}